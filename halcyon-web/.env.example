# Halcyon Web Environment Variables
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=halcyon-mobile-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=halcyon-mobile-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=halcyon-mobile-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# OpenAI API Key (For Root Cause Analysis Engine)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# GitHub OAuth Integration
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
